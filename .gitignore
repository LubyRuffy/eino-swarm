# Go build output
/zwai
/swarm-real
*.test
*.out
coverage.*

# Node
node_modules/
*.tsbuildinfo
frontend/node_modules/
frontend/.vite/
*.log
npm-debug.log*

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/
frontend/.e2e-data/
frontend/.e2e-data-*/

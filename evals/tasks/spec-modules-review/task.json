{
  "id": "spec-modules-review",
  "purpose": "The spec-modules task plus a request that an independent worker, given only the README and the code, review the manager's work. Compared with spec-modules-selfreview it asks whether a fresh context finds what the author's own second pass does not.",
  "expect_delegation": "optional",
  "generate": "generate.py",
  "timeout_s": 1200,
  "checks": [
    {
      "name": "durations meets every README rule",
      "type": "command",
      "argv": [
        "python3",
        "{task_dir}/../spec-modules/hidden/run_hidden.py",
        "durations"
      ],
      "timeout_s": 60
    },
    {
      "name": "semver meets every README rule",
      "type": "command",
      "argv": [
        "python3",
        "{task_dir}/../spec-modules/hidden/run_hidden.py",
        "semver"
      ],
      "timeout_s": 60
    },
    {
      "name": "ranges meets every README rule",
      "type": "command",
      "argv": [
        "python3",
        "{task_dir}/../spec-modules/hidden/run_hidden.py",
        "ranges"
      ],
      "timeout_s": 60
    },
    {
      "name": "durations/README.md unchanged",
      "type": "file_unchanged",
      "path": "durations/README.md"
    },
    {
      "name": "durations/test_basic.py unchanged",
      "type": "file_unchanged",
      "path": "durations/test_basic.py"
    },
    {
      "name": "semver/README.md unchanged",
      "type": "file_unchanged",
      "path": "semver/README.md"
    },
    {
      "name": "semver/test_basic.py unchanged",
      "type": "file_unchanged",
      "path": "semver/test_basic.py"
    },
    {
      "name": "ranges/README.md unchanged",
      "type": "file_unchanged",
      "path": "ranges/README.md"
    },
    {
      "name": "ranges/test_basic.py unchanged",
      "type": "file_unchanged",
      "path": "ranges/test_basic.py"
    },
    {
      "name": "an independent worker was spawned",
      "type": "tool_count",
      "tool": "spawn_agent",
      "agent": "manager",
      "min": 1
    }
  ]
}

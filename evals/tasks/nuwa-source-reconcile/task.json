{
  "id": "nuwa-source-reconcile",
  "purpose": "Evidence reconciliation with an obsolete draft and a superseded component record; no required roles or delegation count.",
  "project_prompt_file": "project.md",
  "expect_delegation": "optional",
  "timeout_s": 600,
  "checks": [
    {"name": "prompt-consistent current-record semantics", "type": "command", "argv": ["python3", "{task_dir}/check_decision.py", "--fixture", "{task_dir}/fixture"], "timeout_s": 10},
    {"name": "engine evidence unchanged", "type": "file_unchanged", "path": "records/engine.json"},
    {"name": "renderer evidence unchanged", "type": "file_unchanged", "path": "records/renderer.json"},
    {"name": "old phone evidence unchanged", "type": "file_unchanged", "path": "records/phone-old.json"},
    {"name": "current phone evidence unchanged", "type": "file_unchanged", "path": "records/phone-current.json"}
  ]
}

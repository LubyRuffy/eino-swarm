{
  "id": "spec-edges",
  "purpose": "Three small modules to write from a README of numbered rules that go against the usual library call or habit (float rounding, separator thresholds, apostrophes, letters NFKD cannot decompose, a prefix counted toward a length limit, collision precedence). Visible tests cover only the plain cases; the rule tests are hidden. The baseline arm of the second review triple, built so that an unreviewed run has rules to miss.",
  "expect_delegation": "optional",
  "generate": "generate.py",
  "timeout_s": 1200,
  "checks": [
    {
      "name": "money meets every README rule",
      "type": "command",
      "argv": [
        "python3",
        "{task_dir}/../spec-edges/hidden/run_hidden.py",
        "money"
      ],
      "timeout_s": 60
    },
    {
      "name": "slug meets every README rule",
      "type": "command",
      "argv": [
        "python3",
        "{task_dir}/../spec-edges/hidden/run_hidden.py",
        "slug"
      ],
      "timeout_s": 60
    },
    {
      "name": "headers meets every README rule",
      "type": "command",
      "argv": [
        "python3",
        "{task_dir}/../spec-edges/hidden/run_hidden.py",
        "headers"
      ],
      "timeout_s": 60
    },
    {
      "name": "money/README.md unchanged",
      "type": "file_unchanged",
      "path": "money/README.md"
    },
    {
      "name": "money/test_basic.py unchanged",
      "type": "file_unchanged",
      "path": "money/test_basic.py"
    },
    {
      "name": "slug/README.md unchanged",
      "type": "file_unchanged",
      "path": "slug/README.md"
    },
    {
      "name": "slug/test_basic.py unchanged",
      "type": "file_unchanged",
      "path": "slug/test_basic.py"
    },
    {
      "name": "headers/README.md unchanged",
      "type": "file_unchanged",
      "path": "headers/README.md"
    },
    {
      "name": "headers/test_basic.py unchanged",
      "type": "file_unchanged",
      "path": "headers/test_basic.py"
    }
  ]
}

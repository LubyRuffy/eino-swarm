{
  "id": "spec-modules-selfreview",
  "purpose": "The spec-modules task plus a request that the manager re-check its own work against every README rule. Separates the value of an extra verification pass from the value of an independent one.",
  "expect_delegation": "optional",
  "generate": "generate.py",
  "timeout_s": 1200,
  "checks": [
    {
      "name": "durations meets every README rule",
      "type": "command",
      "argv": [
        "python3",
        "{task_dir}/../spec-modules/hidden/run_hidden.py",
        "durations"
      ],
      "timeout_s": 60
    },
    {
      "name": "semver meets every README rule",
      "type": "command",
      "argv": [
        "python3",
        "{task_dir}/../spec-modules/hidden/run_hidden.py",
        "semver"
      ],
      "timeout_s": 60
    },
    {
      "name": "ranges meets every README rule",
      "type": "command",
      "argv": [
        "python3",
        "{task_dir}/../spec-modules/hidden/run_hidden.py",
        "ranges"
      ],
      "timeout_s": 60
    },
    {
      "name": "durations/README.md unchanged",
      "type": "file_unchanged",
      "path": "durations/README.md"
    },
    {
      "name": "durations/test_basic.py unchanged",
      "type": "file_unchanged",
      "path": "durations/test_basic.py"
    },
    {
      "name": "semver/README.md unchanged",
      "type": "file_unchanged",
      "path": "semver/README.md"
    },
    {
      "name": "semver/test_basic.py unchanged",
      "type": "file_unchanged",
      "path": "semver/test_basic.py"
    },
    {
      "name": "ranges/README.md unchanged",
      "type": "file_unchanged",
      "path": "ranges/README.md"
    },
    {
      "name": "ranges/test_basic.py unchanged",
      "type": "file_unchanged",
      "path": "ranges/test_basic.py"
    }
  ]
}

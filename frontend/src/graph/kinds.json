    {
      "id": "asset",
      "name": {
        "en": "Asset",
        "zh": "资产"
      },
      "description": "One network service as FOFA sees it: IP, port, protocol and optional host together. Only IP and port are required; with only a domain or URL it is not yet an asset.",
      "display": [
        "host",
        "{ip}:{port}"
      ],
      "attrs": [
        {
          "name": "ip",
          "type": "string",
          "label": {
            "en": "IP",
            "zh": "IP"
          }
        },
        {
          "name": "port",
          "type": "int",
          "label": {
            "en": "Port",
            "zh": "端口"
          },
          "min": 1,
          "max_value": 65535
        },
        {
          "name": "protocol",
          "type": "string",
          "label": {
            "en": "Protocol",
            "zh": "协议"
          }
        },
        {
          "name": "host",
          "type": "string",
          "label": {
            "en": "Host",
            "zh": "主机"
          }
        },
        {
          "name": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "zh": "标题"
          }
        },
        {
          "name": "country",
          "type": "string",
          "label": {
            "en": "Country",
            "zh": "国家"
          }
        },
        {
          "name": "note",
          "type": "text",
          "label": {
            "en": "Note",
            "zh": "说明"
          }
        }

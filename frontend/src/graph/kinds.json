      "id": "repo",
      "name": {
        "en": "Code repository",
        "zh": "代码仓库"
      },
      "description": "A git, svn or similar repository. Shown by its path (owner/name); the full address and the credential are attributes. Credentials embedded in an address move to the credential attribute.",
      "display": [
        "path",
        "url"
      ],
      "attrs": [
        {
          "name": "path",
          "type": "string",
          "label": {
            "en": "Path",
            "zh": "路径"
          }
        },
        {
          "name": "url",
          "type": "string",
          "label": {
            "en": "Address",
            "zh": "完整地址"
          },
          "max": 2048,
          "strip_userinfo_to": "credential",
          "derive_path_to": "path"
        },
        {
          "name": "vcs",
          "type": "string",
          "label": {
            "en": "VCS",
            "zh": "版本控制"
          }
        },
        {
          "name": "credential",
          "type": "string",
          "label": {
            "en": "Credential",
            "zh": "凭证"
          },
          "secret": true
        },
        {
          "name": "note",
          "type": "text",
          "label": {
            "en": "Note",
            "zh": "说明"
